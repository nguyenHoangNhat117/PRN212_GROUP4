<Page x:Class="PRN212_GROUP4.Views.ReportsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#FFFDF5"
      FontFamily="{StaticResource PlayfulGeometricReading}"
      Foreground="#253044">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock
            Text="Báo cáo học tập"
            FontFamily="{StaticResource PlayfulGeometricDisplay}"
            FontSize="25"
            FontWeight="Bold"
            Margin="0,0,0,20"/>

        <!-- Tiêu chí báo cáo -->
        <Border Grid.Row="1"
                Style="{StaticResource Card}"
                Padding="16"
                Margin="0,0,6,20">

            <WrapPanel IsEnabled="{Binding CanInteract}">

                <StackPanel Margin="0,0,12,8">
                    <TextBlock Text="Loại báo cáo"
                               Style="{StaticResource Label}"/>

                    <ComboBox Width="170"
                              ItemsSource="{Binding Types}"
                              SelectedItem="{Binding Type}"/>
                </StackPanel>

                <StackPanel Margin="0,0,12,8">
                    <TextBlock Text="Sinh viên"
                               Style="{StaticResource Label}"/>

                    <ComboBox Width="220"
                              ItemsSource="{Binding Students}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding StudentId}"/>
                </StackPanel>

                <StackPanel Margin="0,0,12,8">
                    <TextBlock Text="Học kỳ"
                               Style="{StaticResource Label}"/>

                    <ComboBox Width="140"
                              ItemsSource="{Binding Semesters}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding SemesterId}"/>
                </StackPanel>

                <StackPanel Margin="0,0,12,8">
                    <TextBlock Text="Lớp"
                               Style="{StaticResource Label}"/>

                    <ComboBox Width="140"
                              ItemsSource="{Binding Classes}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding ClassId}"/>
                </StackPanel>

                <Button Content="Tạo báo cáo"
                        Command="{Binding GenerateCommand}"
                        Padding="12,5"
                        Margin="0,12,10,8"/>

                <Button Content="Xuất CSV"
                        Command="{Binding ExportCsvCommand}"
                        Padding="12,5"
                        Margin="0,12,0,8"/>
            </WrapPanel>
        </Border>

        <!-- Bảng báo cáo -->
        <Border Grid.Row="2"
                Style="{StaticResource Card}"
                Padding="0"
                Margin="0,0,6,6">

            <DataGrid ItemsSource="{Binding Rows}"
                      IsReadOnly="True"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã SV"
                                        Binding="{Binding StudentCode}"/>

                    <DataGridTextColumn Header="Họ tên"
                                        Binding="{Binding FullName}"/>

                    <DataGridTextColumn Header="Khoa"
                                        Binding="{Binding Department}"/>

                    <DataGridTextColumn Header="Học kỳ"
                                        Binding="{Binding Semester}"/>

                    <DataGridTextColumn Header="Lớp"
                                        Binding="{Binding Class}"/>

                    <DataGridTextColumn Header="Môn"
                                        Binding="{Binding Course}"/>

                    <DataGridTextColumn Header="Tín chỉ"
                                        Binding="{Binding Credits}"/>

                    <DataGridTextColumn Header="Điểm"
                                        Binding="{Binding Score}"/>

                    <DataGridTextColumn Header="Điểm chữ"
                                        Binding="{Binding Letter}"/>

                    <DataGridTextColumn Header="GPA học kỳ"
                                        Binding="{Binding SemesterGpa}"/>

                    <DataGridTextColumn Header="GPA tích lũy"
                                        Binding="{Binding CumulativeGpa}"/>

                    <DataGridTextColumn Header="Trạng thái"
                                        Binding="{Binding Status}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="3"
                   Text="{Binding Message}"
                   TextWrapping="Wrap"
                   Foreground="#78716C"
                   Margin="0,12,0,0"/>
    </Grid>
</Page>