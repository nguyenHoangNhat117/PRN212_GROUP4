<Page x:Class="PRN212_GROUP4.Views.ProgressView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#FFFDF5"
      FontFamily="{StaticResource PlayfulGeometricReading}"
      Foreground="#253044">

    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock
                Text="Tiến độ học tập"
                FontFamily="{StaticResource PlayfulGeometricDisplay}"
                FontSize="27"
                FontWeight="Bold"/>

            <TextBlock
                Text="Kết quả, tín chỉ và GPA theo phạm vi được phân quyền."
                Foreground="#78716C"
                Margin="0,7,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Style="{StaticResource Card}"
                Padding="16"
                Margin="0,0,6,18"
                IsEnabled="{Binding CanInteract}">

            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Sinh viên"
                               Style="{StaticResource Label}"/>
                    <ComboBox Width="300"
                              ItemsSource="{Binding Students}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding StudentId}"/>
                </StackPanel>

                <Button Content="Tải lại"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource Secondary}"
                        VerticalAlignment="Bottom"/>
            </StackPanel>
        </Border>

        <!-- Các chỉ số -->
        <UniformGrid Grid.Row="2"
                     Rows="1"
                     Columns="5"
                     Margin="0,0,6,18">

            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,14,0">
                <StackPanel>
                    <TextBlock Text="GPA TÍCH LŨY" Foreground="#C2410C"
                               FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="{Binding GpaText}"
                               FontFamily="{StaticResource PlayfulGeometricDisplay}"
                               FontSize="22" FontWeight="Bold"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,14,0">
                <StackPanel>
                    <TextBlock Text="TÍN CHỈ ĐĂNG KÝ" Foreground="#C2410C"
                               FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="{Binding RegisteredText}"
                               FontFamily="{StaticResource PlayfulGeometricDisplay}"
                               FontSize="22" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,14,0">
                <StackPanel>
                    <TextBlock Text="ĐANG HỌC" Foreground="#C2410C"
                               FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="{Binding InProgressText}"
                               FontFamily="{StaticResource PlayfulGeometricDisplay}"
                               FontSize="22" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,14,0">
                <StackPanel>
                    <TextBlock Text="ĐÃ CÓ KẾT QUẢ" Foreground="#C2410C"
                               FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="{Binding WithResultText}"
                               FontFamily="{StaticResource PlayfulGeometricDisplay}"
                               FontSize="22" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="14">
                <StackPanel>
                    <TextBlock Text="TÍN CHỈ ĐẠT" Foreground="#C2410C"
                               FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="{Binding PassedText}"
                               FontFamily="{StaticResource PlayfulGeometricDisplay}"
                               FontSize="22" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="3"
                Style="{StaticResource Card}"
                Padding="0"
                Margin="0,0,6,6">

            <DataGrid ItemsSource="{Binding Courses}"
                      AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Học kỳ"
                                        Binding="{Binding Semester}"
                                        Width="110"/>
                    <DataGridTextColumn Header="Môn học"
                                        Binding="{Binding Course}"
                                        Width="1.8*"/>
                    <DataGridTextColumn Header="Lớp"
                                        Binding="{Binding Class}"
                                        Width="110"/>
                    <DataGridTextColumn Header="Tín chỉ"
                                        Binding="{Binding Credits}"
                                        Width="80"/>
                    <DataGridTextColumn Header="Trạng thái"
                                        Binding="{Binding Status}"
                                        Width="150"/>
                    <DataGridTextColumn Header="Điểm"
                                        Binding="{Binding ScoreText}"
                                        Width="70"/>
                    <DataGridTextColumn Header="Xếp loại"
                                        Binding="{Binding Letter}"
                                        Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="4"
                   Text="{Binding Message}"
                   Foreground="#78716C"
                   TextWrapping="Wrap"
                   Margin="0,14,0,0"/>
    </Grid>
</Page>