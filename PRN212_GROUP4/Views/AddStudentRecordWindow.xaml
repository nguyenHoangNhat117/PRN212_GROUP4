<Window x:Class="PRN212_GROUP4.Views.AddStudentRecordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Student Record"
        Width="640"
        Height="700"
        MinWidth="540"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#F6F5F2"
        FontFamily="Segoe UI"
        UseLayoutRounding="True">

    <Window.Resources>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#655E57"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,18,0,7"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#292524"/>
            <Setter Property="Background" Value="#FCFBF9"/>
            <Setter Property="BorderBrush" Value="#DED7CE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#C2410C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FormButton" TargetType="Button">
            <Setter Property="Background" Value="#C2410C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#C2410C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="22,12"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">

                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>

                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#292524"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="Add academic record"
                       FontSize="25"
                       FontWeight="Bold"
                       Foreground="#292524"/>

            <StackPanel Orientation="Horizontal"
                        Margin="0,8,0,0">

                <TextBlock Text="{Binding Student.StudentCode}"
                           Foreground="#A9380A"
                           FontWeight="SemiBold"/>

                <TextBlock Text=" — "
                           Foreground="#756E66"/>

                <TextBlock Text="{Binding Student.FullName}"
                           Foreground="#655E57"/>
            </StackPanel>
        </StackPanel>

        <!-- FORM -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E8E3DD"
                BorderThickness="1"
                CornerRadius="14"
                Padding="22">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="FormPanel"
                            Margin="0,0,8,0">

                    <TextBlock Text="Record type *"
                               Style="{StaticResource FieldLabel}"
                               Margin="0,0,0,7"/>

                    <TextBox MaxLength="60"
                             Text="{Binding NewRecord.RecordType,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Record title *"
                               Style="{StaticResource FieldLabel}"/>

                    <TextBox MaxLength="180"
                             Text="{Binding NewRecord.RecordTitle,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Record date *"
                               Style="{StaticResource FieldLabel}"/>

                    <DatePicker Height="40"
                                FontSize="14"
                                SelectedDateFormat="Short"
                                VerticalContentAlignment="Center"
                                SelectedDate="{Binding RecordDate,
                                                       Mode=TwoWay}"/>

                    <TextBlock Text="Content"
                               Style="{StaticResource FieldLabel}"/>

                    <TextBox Height="160"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding NewRecord.RecordContent,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="* Required fields"
                               Foreground="#756E66"
                               FontSize="12"
                               Margin="0,18,0,0"/>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- FOOTER -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="OperationStatus"
                       Foreground="#756E66"
                       FontSize="12"
                       VerticalAlignment="Center"/>

            <Button x:Name="CancelButton"
                    Grid.Column="1"
                    Content="Cancel"
                    IsCancel="True"
                    Style="{StaticResource FormButton}"
                    Background="White"
                    Foreground="#3E3934"
                    BorderBrush="#DED7CE"
                    Margin="0,0,10,0"/>

            <Button x:Name="SaveButton"
                    Grid.Column="2"
                    Content="Save record"
                    Click="SaveButton_Click"
                    Style="{StaticResource FormButton}"/>
        </Grid>
    </Grid>
</Window>