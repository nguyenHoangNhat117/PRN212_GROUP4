<Window x:Class="PRN212_GROUP4.Views.AddStudentRecordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Student Record"
        Width="640"
        Height="700"
        MinWidth="540"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#FFFDF5"
        FontFamily="{StaticResource PlayfulGeometricReading}"
        UseLayoutRounding="True">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,20">
            <TextBlock
                Text="Add academic record"
                FontFamily="{StaticResource PlayfulGeometricDisplay}"
                FontSize="25"
                FontWeight="Bold"
                Foreground="#253044"/>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="{Binding Student.StudentCode}"
                           Foreground="#A9380A"
                           FontWeight="SemiBold"/>

                <TextBlock Text=" — " Foreground="#756E66"/>

                <TextBlock Text="{Binding Student.FullName}"
                           Foreground="#655E57"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1"
                Style="{StaticResource Card}"
                Padding="22"
                Margin="0,0,6,6">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="FormPanel"
                            Margin="0,0,8,0"
                            IsEnabled="{Binding IsFormEnabled}">

                    <TextBlock Text="Record type *"
                               Style="{StaticResource FieldLabel}"
                               Margin="0,0,0,7"/>

                    <TextBox
                        MaxLength="60"
                        Text="{Binding NewRecord.RecordType,
                            Mode=TwoWay,
                            UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Mã chứng từ *" Style="{StaticResource FieldLabel}"/>
                    <TextBox MaxLength="80" Text="{Binding NewRecord.DocumentNumber, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Record title *"
                               Style="{StaticResource FieldLabel}"/>

                    <TextBox
                        MaxLength="180"
                        Text="{Binding NewRecord.RecordTitle,
                            Mode=TwoWay,
                            UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Record date *"
                               Style="{StaticResource FieldLabel}"/>

                    <DatePicker
                        Height="40"
                        FontSize="14"
                        SelectedDateFormat="Short"
                        VerticalContentAlignment="Center"
                        SelectedDate="{Binding RecordDate, Mode=TwoWay}"/>

                    <TextBlock Text="Content"
                               Style="{StaticResource FieldLabel}"/>

                    <TextBox
                        Height="160"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        VerticalContentAlignment="Top"
                        VerticalScrollBarVisibility="Auto"
                        Text="{Binding NewRecord.RecordContent,
                            Mode=TwoWay,
                            UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="* Required fields"
                               Foreground="#756E66"
                               FontSize="12"
                               Margin="0,18,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="OperationStatus"
                       Grid.Column="0"
                       Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       Margin="0,0,12,0"
                       Foreground="#756E66"
                       FontSize="12"
                       VerticalAlignment="Center"/>

            <Button x:Name="CancelButton"
                    Grid.Column="1"
                    Content="Cancel"
                    IsCancel="True"
                    IsEnabled="{Binding CanClose}"
                    Style="{StaticResource FormButton}"
                    Background="White"
                    Foreground="#3E3934"
                    BorderBrush="#9298A4"
                    Margin="0,0,10,0"/>

            <Button x:Name="SaveButton"
                    Grid.Column="2"
                    Content="Save record"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource FormButton}"/>
        </Grid>
    </Grid>
</Window>