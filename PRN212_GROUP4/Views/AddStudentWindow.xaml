<Window x:Class="PRN212_GROUP4.Views.AddStudentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Student"
        Width="760"
        Height="820"
        MinWidth="600"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#FFFDF5"
        FontFamily="{StaticResource PlayfulGeometricReading}"
        UseLayoutRounding="True">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,22">
            <TextBlock
                Text="Add student"
                FontFamily="{StaticResource PlayfulGeometricDisplay}"
                FontSize="28"
                FontWeight="Bold"
                Foreground="#253044"/>

            <TextBlock Text="Create a new student profile."
                       Foreground="#756E66"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Style="{StaticResource Card}"
                Padding="22"
                Margin="0,0,6,6">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="FormPanel"
                            Margin="0,0,8,0"
                            IsEnabled="{Binding IsFormEnabled}">

                    <TextBlock Text="Student code *"
                               Style="{StaticResource FieldLabel}"
                               Margin="0,0,0,7"/>

                    <TextBox
                        MaxLength="20"
                        Text="{Binding NewStudent.StudentCode,
                            Mode=TwoWay,
                            UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Full name *"
                               Style="{StaticResource FieldLabel}"/>

                    <TextBox
                        MaxLength="120"
                        Text="{Binding NewStudent.FullName,
                            Mode=TwoWay,
                            UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Date of birth (dd/MM/yyyy)"
                               Style="{StaticResource FieldLabel}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox
                            MaxLength="10"
                            ToolTip="Ví dụ: 20/10/2004"
                            Text="{Binding Dates.DateOfBirthText,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"/>

                        <DatePicker
                            Grid.Column="1"
                            Style="{StaticResource CalendarButton}"
                            SelectedDate="{Binding Dates.DateOfBirthCalendar,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <TextBlock Text="Email"
                               Style="{StaticResource FieldLabel}"/>

                    <TextBox
                        MaxLength="255"
                        Text="{Binding NewStudent.Email,
                            Mode=TwoWay,
                            UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Phone"
                               Style="{StaticResource FieldLabel}"/>

                    <TextBox
                        MaxLength="30"
                        Text="{Binding NewStudent.Phone,
                            Mode=TwoWay,
                            UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Department (optional)"
                               Style="{StaticResource FieldLabel}"/>

                    <ComboBox
                        ItemsSource="{Binding Departments}"
                        DisplayMemberPath="DepartmentName"
                        SelectedValuePath="DepartmentID"
                        SelectedValue="{Binding NewStudent.DepartmentID,
                            Mode=TwoWay}"/>

                    <TextBlock Text="Enrollment date (dd/MM/yyyy)"
                               Style="{StaticResource FieldLabel}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox
                            MaxLength="10"
                            ToolTip="Nhập ngày/tháng/năm"
                            Text="{Binding Dates.EnrollmentDateText,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"/>

                        <DatePicker
                            Grid.Column="1"
                            Style="{StaticResource CalendarButton}"
                            SelectedDate="{Binding Dates.EnrollmentDateCalendar,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <TextBlock Text="Student status"
                               Style="{StaticResource FieldLabel}"/>

                    <ComboBox
                        ItemsSource="{Binding StudentStatuses}"
                        SelectedItem="{Binding NewStudent.StudentStatus,
                            Mode=TwoWay}"/>

                    <TextBlock Text="* Required fields"
                               Foreground="#756E66"
                               FontSize="12"
                               Margin="0,18,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="OperationStatus"
                       Text="{Binding StatusMessage}"
                       Foreground="#B42318"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"/>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button x:Name="CancelButton"
                        Content="Cancel"
                        IsCancel="True"
                        IsEnabled="{Binding CanClose}"
                        Style="{StaticResource FormButton}"
                        Background="White"
                        Foreground="#3E3934"
                        BorderBrush="#9298A4"
                        Margin="0,0,10,0"/>

                <Button x:Name="SaveButton"
                        Content="Save student"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource FormButton}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>