<Window x:Class="PRN212_GROUP4.Views.AddStudentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm sinh viên"
        Width="760"
        Height="860"
        MinWidth="600"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#FFFDF5"
        FontFamily="{StaticResource PlayfulGeometricReading}"
        UseLayoutRounding="True">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,22">
            <TextBlock
                Text="Thêm sinh viên"
                FontFamily="{StaticResource PlayfulGeometricDisplay}"
                FontSize="28"
                FontWeight="Bold"
                Foreground="#253044"/>

            <TextBlock
                Text="Nhập thông tin cá nhân và ngành học. Các mục * là bắt buộc."
                Foreground="#756E66"
                TextWrapping="Wrap"
                Margin="0,8,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Style="{StaticResource Card}"
                Padding="22"
                Margin="0,0,6,6">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="FormPanel"
                            Margin="0,0,8,0"
                            IsEnabled="{Binding IsFormEnabled}">

                    <TextBlock Text="Mã sinh viên *"
                               Style="{StaticResource FieldLabel}"
                               Margin="0,0,0,7"/>

                    <TextBox
                        MaxLength="20"
                        Text="{Binding NewStudent.StudentCode,
                            Mode=TwoWay,
                            UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Họ và tên *"
                               Style="{StaticResource FieldLabel}"/>

                    <TextBox
                        MaxLength="120"
                        Text="{Binding NewStudent.FullName,
                            Mode=TwoWay,
                            UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Ngày sinh — dd/MM/yyyy *"
                               Style="{StaticResource FieldLabel}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox
                            MaxLength="10"
                            ToolTip="Ví dụ: 20/10/2005"
                            Text="{Binding Dates.DateOfBirthText,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"/>

                        <DatePicker
                            Grid.Column="1"
                            Style="{StaticResource CalendarButton}"
                            SelectedDate="{Binding Dates.DateOfBirthCalendar,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <TextBlock Text="Giới tính *"
                               Style="{StaticResource FieldLabel}"/>

                    <ComboBox
                        ItemsSource="{Binding Genders}"
                        SelectedItem="{Binding NewStudent.Gender,
                            Mode=TwoWay,
                            UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Email *"
                               Style="{StaticResource FieldLabel}"/>

                    <TextBox
                        MaxLength="255"
                        Text="{Binding NewStudent.Email,
                            Mode=TwoWay,
                            UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Số điện thoại *"
                               Style="{StaticResource FieldLabel}"/>

                    <TextBox
                        MaxLength="16"
                        ToolTip="Nhập 8–15 chữ số; có thể bắt đầu bằng dấu +"
                        Text="{Binding NewStudent.Phone,
                            Mode=TwoWay,
                            UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Địa chỉ *"
                               Style="{StaticResource FieldLabel}"/>

                    <TextBox
                        MaxLength="250"
                        MinHeight="70"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto"
                        Text="{Binding NewStudent.Address,
                            Mode=TwoWay,
                            UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Khoa phụ trách"
                               Style="{StaticResource FieldLabel}"/>

                    <ComboBox
                        IsEnabled="False"
                        ItemsSource="{Binding Departments}"
                        DisplayMemberPath="DepartmentName"
                        SelectedValuePath="DepartmentID"
                        SelectedValue="{Binding NewStudent.DepartmentID,
                            Mode=OneWay}"/>

                    <TextBlock
                        Text="Sinh viên được thêm vào khoa của nhân viên học vụ đang đăng nhập."
                        Foreground="#756E66"
                        FontSize="12"
                        TextWrapping="Wrap"
                        Margin="0,6,0,0"/>

                    <TextBlock Text="Ngành học *"
                               Style="{StaticResource FieldLabel}"/>

                    <ComboBox
                        ItemsSource="{Binding Majors}"
                        DisplayMemberPath="Name"
                        SelectedValuePath="Id"
                        SelectedValue="{Binding NewStudent.MajorID,
                            Mode=TwoWay,
                            UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Khóa tuyển sinh *"
                               Style="{StaticResource FieldLabel}"/>

                    <TextBox
                        MaxLength="20"
                        ToolTip="Ví dụ: K2026"
                        Text="{Binding NewStudent.Cohort,
                            Mode=TwoWay,
                            UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Ngày nhập học — dd/MM/yyyy *"
                               Style="{StaticResource FieldLabel}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox
                            MaxLength="10"
                            ToolTip="Nhập ngày/tháng/năm"
                            Text="{Binding Dates.EnrollmentDateText,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"/>

                        <DatePicker
                            Grid.Column="1"
                            Style="{StaticResource CalendarButton}"
                            SelectedDate="{Binding Dates.EnrollmentDateCalendar,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <TextBlock Text="Trạng thái học tập *"
                               Style="{StaticResource FieldLabel}"/>

                    <ComboBox
                        ItemsSource="{Binding StudentStatuses}"
                        SelectedItem="{Binding NewStudent.StudentStatus,
                            Mode=TwoWay,
                            UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Người liên hệ khẩn cấp"
                               Style="{StaticResource FieldLabel}"/>

                    <TextBox
                        MaxLength="120"
                        Text="{Binding NewStudent.EmergencyContactName,
                            Mode=TwoWay,
                            UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Số điện thoại liên hệ khẩn cấp"
                               Style="{StaticResource FieldLabel}"/>

                    <TextBox
                        MaxLength="16"
                        Text="{Binding NewStudent.EmergencyContactPhone,
                            Mode=TwoWay,
                            UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock
                        Text="Liên hệ khẩn cấp: nhập đủ tên và số điện thoại, hoặc để trống cả hai."
                        Foreground="#756E66"
                        FontSize="12"
                        TextWrapping="Wrap"
                        Margin="0,10,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="OperationStatus"
                       Text="{Binding StatusMessage}"
                       Foreground="#B42318"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"/>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button x:Name="CancelButton"
                        Content="Hủy"
                        IsCancel="True"
                        IsEnabled="{Binding CanClose}"
                        Style="{StaticResource FormButton}"
                        Background="White"
                        Foreground="#3E3934"
                        BorderBrush="#9298A4"
                        Margin="0,0,10,0"/>

                <Button x:Name="SaveButton"
                        Content="Lưu sinh viên"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource FormButton}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>