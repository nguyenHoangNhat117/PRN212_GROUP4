<Window x:Class="PRN212_GROUP4.Views.AddStudentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Student"
        Width="620"
        Height="720"
        MinWidth="540"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#F6F5F2"
        FontFamily="Segoe UI"
        UseLayoutRounding="True">

    <Window.Resources>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#292524"/>
            <Setter Property="Background" Value="#FCFBF9"/>
            <Setter Property="BorderBrush" Value="#DED7CE"/>
            <Setter Property="BorderThickness" Value="1"/>

            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#C2410C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#292524"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SelectedDateFormat" Value="Short"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#655E57"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>

        <Style x:Key="FormButton" TargetType="Button">
            <Setter Property="Padding" Value="22,12"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#C2410C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#C2410C"/>
            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">

                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>

                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#292524"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Margin="0,0,0,22">
            <TextBlock Text="Add student"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#292524"/>

            <TextBlock Text="Create a new student profile."
                       FontSize="13"
                       Foreground="#756E66"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <!-- FORM -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E8E3DD"
                BorderThickness="1"
                CornerRadius="14"
                Padding="22">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="FormPanel" Margin="0,0,8,0">

                    <TextBlock Text="Student code *"
                               Style="{StaticResource FieldLabel}"/>

                    <TextBox MaxLength="20"
                             Text="{Binding NewStudent.StudentCode,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Full name *"
                               Style="{StaticResource FieldLabel}"
                               Margin="0,18,0,7"/>

                    <TextBox MaxLength="120"
                             Text="{Binding NewStudent.FullName,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Date of birth"
                               Style="{StaticResource FieldLabel}"
                               Margin="0,18,0,7"/>

                    <DatePicker
                        SelectedDate="{Binding NewStudent.DateOfBirth,
                                               Mode=TwoWay}"/>

                    <TextBlock Text="Email"
                               Style="{StaticResource FieldLabel}"
                               Margin="0,18,0,7"/>

                    <TextBox MaxLength="255"
                             Text="{Binding NewStudent.Email,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Phone"
                               Style="{StaticResource FieldLabel}"
                               Margin="0,18,0,7"/>

                    <TextBox MaxLength="30"
                             Text="{Binding NewStudent.Phone,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Department (optional)"
                               Style="{StaticResource FieldLabel}"
                               Margin="0,18,0,7"/>

                    <ComboBox ItemsSource="{Binding Departments}"
                              DisplayMemberPath="DepartmentName"
                              SelectedValuePath="DepartmentID"
                              SelectedValue="{Binding NewStudent.DepartmentID,
                                                      Mode=TwoWay}"/>

                    <TextBlock Text="Enrollment date"
                               Style="{StaticResource FieldLabel}"
                               Margin="0,18,0,7"/>

                    <DatePicker
                        SelectedDate="{Binding NewStudent.EnrollmentDate,
                                               Mode=TwoWay}"/>

                    <TextBlock Text="Student status"
                               Style="{StaticResource FieldLabel}"
                               Margin="0,18,0,7"/>

                    <ComboBox ItemsSource="{Binding StudentStatuses}"
                              SelectedItem="{Binding NewStudent.StudentStatus,
                                                     Mode=TwoWay}"/>

                    <TextBlock Text="* Required fields"
                               FontSize="12"
                               Foreground="#756E66"
                               Margin="0,20,0,0"/>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ACTIONS -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="OperationStatus"
                       Text="Loading departments..."
                       Foreground="#756E66"
                       FontSize="12"
                       VerticalAlignment="Center"/>

            <Button x:Name="CancelButton"
                    Grid.Column="1"
                    Content="Cancel"
                    IsCancel="True"
                    Style="{StaticResource FormButton}"
                    Background="White"
                    Foreground="#3E3934"
                    BorderBrush="#DED7CE"
                    Margin="0,0,10,0"/>

            <Button x:Name="SaveButton"
                    Grid.Column="2"
                    Content="Save student"
                    IsEnabled="False"
                    Click="SaveButton_Click"
                    Style="{StaticResource FormButton}"/>
        </Grid>
    </Grid>
</Window>