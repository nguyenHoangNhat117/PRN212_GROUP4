<Page x:Class="PRN212_GROUP4.Views.StudentView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Students"
      Background="#F6F5F2"
      FontFamily="Segoe UI"
      UseLayoutRounding="True">

    <Page.Resources>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E8E3DD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="22"/>
        </Style>

        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#756E66"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,18,0,5"/>
        </Style>

        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#292524"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F5F3EF"/>
            <Setter Property="Foreground" Value="#655E57"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#3E3934"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                Padding="14,0">
                            <ContentPresenter
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="BorderBrush" Value="#F0ECE6"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF6ED"/>
                </Trigger>

                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFE8D6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="Background" Value="#F0EDE8"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>

            <Style.Triggers>
                <DataTrigger Binding="{Binding StudentStatus}"
                             Value="ACTIVE">
                    <Setter Property="Background" Value="#E9F3ED"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding StudentStatus}"
                             Value="GRADUATED">
                    <Setter Property="Background" Value="#FFF0E5"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding StudentStatus}"
                             Value="SUSPENDED">
                    <Setter Property="Background" Value="#FCECE8"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </Page.Resources>

    <Grid Margin="32,28,32,30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- PAGE TITLE -->
        <StackPanel Margin="0,0,0,24">
            <TextBlock Text="Student profiles"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#292524"/>

            <TextBlock Text="Select a student to view profile details."
                       FontSize="13"
                       Foreground="#756E66"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="22"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- STUDENT LIST -->
            <Border Grid.Column="0"
                    Style="{StaticResource Card}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Student directory"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#292524"/>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,5,0,0">
                                <TextBlock Text="{Binding Students.Count}"
                                           FontWeight="SemiBold"
                                           Foreground="#756E66"
                                           FontSize="12"/>

                                <TextBlock Text=" students"
                                           Foreground="#756E66"
                                           FontSize="12"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="12,0,0,0">

                            <Button Content="Records"
                                    Command="{Binding ViewRecordsCommand}"
                                    Style="{DynamicResource ActionButton}"
                                    Background="#F0EDE8"
                                    Foreground="#3E3934"
                                    Padding="14,10"
                                    Margin="0,0,10,0"/>

                            <Button Content="Edit"
                                    Command="{Binding EditStudentCommand}"
                                    Style="{DynamicResource ActionButton}"
                                    Background="#F0EDE8"
                                    Foreground="#3E3934"
                                    Padding="14,10"
                                    Margin="0,0,10,0"/>

                            <Button Content="+ Add Student"
                                    Command="{Binding AddStudentCommand}"
                                    Style="{DynamicResource ActionButton}"
                                    Background="#C2410C"
                                    Foreground="White"
                                    Padding="14,10"/>
                        </StackPanel>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Students}"
                              SelectedItem="{Binding SelectedStudent, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              RowHeaderWidth="0"
                              RowHeight="52"
                              ColumnHeaderHeight="46"
                              BorderThickness="0"
                              Background="White"
                              RowBackground="White"
                              AlternatingRowBackground="#FCFBF9"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="CODE"
                                                Binding="{Binding StudentCode}"
                                                Width="110"/>

                            <DataGridTextColumn Header="FULL NAME"
                                                Binding="{Binding FullName}"
                                                Width="*"
                                                MinWidth="170"/>

                            <DataGridTemplateColumn Header="STATUS"
                                                    Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StatusBadge}">
                                            <TextBlock
                                                Text="{Binding StudentStatus}"
                                                Foreground="#3E3934"
                                                FontWeight="SemiBold"
                                                FontSize="11"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- STUDENT DETAILS -->
            <Border Grid.Column="2"
                    Style="{StaticResource Card}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="Profile details"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#292524"/>

                        <Border Height="3"
                                Width="36"
                                Background="#C2410C"
                                CornerRadius="2"
                                HorizontalAlignment="Left"
                                Margin="0,12,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="1">

                        <!-- NO STUDENT SELECTED -->
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>

                                    <Style.Triggers>
                                        <DataTrigger
                                            Binding="{Binding SelectedStudent}"
                                            Value="{x:Null}">
                                            <Setter Property="Visibility"
                                                    Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <Border Width="64"
                                    Height="64"
                                    Background="#FFF0E5"
                                    CornerRadius="20"
                                    HorizontalAlignment="Center">

                                <TextBlock Text="&#xE77B;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="26"
                                           Foreground="#C2410C"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="No student selected"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#292524"
                                       TextAlignment="Center"
                                       Margin="0,18,0,8"/>

                            <TextBlock
                                Text="Choose a student from the list to view their profile."
                                Foreground="#756E66"
                                FontSize="12"
                                TextAlignment="Center"
                                TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- SELECTED STUDENT -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">

                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility"
                                            Value="Visible"/>

                                    <Style.Triggers>
                                        <DataTrigger
                                            Binding="{Binding SelectedStudent}"
                                            Value="{x:Null}">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>

                            <StackPanel Margin="0,0,8,8">

                                <Border Background="#FFF0E5"
                                        CornerRadius="12"
                                        Padding="16">

                                    <StackPanel>
                                        <TextBlock
                                            Text="{Binding SelectedStudent.StudentCode}"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="#A9380A"/>

                                        <TextBlock
                                            Text="{Binding SelectedStudent.FullName}"
                                            FontSize="20"
                                            FontWeight="Bold"
                                            Foreground="#292524"
                                            TextWrapping="Wrap"
                                            Margin="0,7,0,0"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Date of birth"
                                           Style="{StaticResource DetailLabel}"/>

                                <TextBlock
                                    Text="{Binding SelectedStudent.DateOfBirth,
                                                   StringFormat={}{0:dd/MM/yyyy},
                                                   TargetNullValue=—}"
                                    Style="{StaticResource DetailValue}"/>

                                <TextBlock Text="Email"
                                           Style="{StaticResource DetailLabel}"/>

                                <TextBlock
                                    Text="{Binding SelectedStudent.Email,
                                                   TargetNullValue=—}"
                                    Style="{StaticResource DetailValue}"/>

                                <TextBlock Text="Phone"
                                           Style="{StaticResource DetailLabel}"/>

                                <TextBlock
                                    Text="{Binding SelectedStudent.Phone,
                                                   TargetNullValue=—}"
                                    Style="{StaticResource DetailValue}"/>

                                <!-- DEPARTMENT: CHỈ HIỂN THỊ MỘT LẦN -->
                                <TextBlock Text="Department"
                                           Style="{StaticResource DetailLabel}"/>

                                <TextBlock
                                    Text="{Binding SelectedStudent.DepartmentName,
                                                   TargetNullValue=Chưa có khoa}"
                                    Style="{StaticResource DetailValue}"/>

                                <TextBlock Text="Enrollment date"
                                           Style="{StaticResource DetailLabel}"/>

                                <TextBlock
                                    Text="{Binding SelectedStudent.EnrollmentDate,
                                                   StringFormat={}{0:dd/MM/yyyy},
                                                   TargetNullValue=—}"
                                    Style="{StaticResource DetailValue}"/>

                                <TextBlock Text="Student status"
                                           Style="{StaticResource DetailLabel}"/>

                                <TextBlock
                                    Text="{Binding SelectedStudent.StudentStatus}"
                                    Style="{StaticResource DetailValue}"/>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>