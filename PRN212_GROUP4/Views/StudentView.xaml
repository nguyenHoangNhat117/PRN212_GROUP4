<Page x:Class="PRN212_GROUP4.Views.StudentView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#FFFDF5"
      FontFamily="{StaticResource PlayfulGeometricReading}"
      Foreground="#253044">

    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề và nút thêm -->
        <DockPanel Margin="0,0,0,20">
            <Button DockPanel.Dock="Right"
                    Content="+  Thêm sinh viên"
                    Command="{Binding AddStudentCommand}"
                    Visibility="{Binding CanManageStudents,
                        Converter={StaticResource BoolVisibility}}"/>

            <StackPanel>
                <TextBlock
                    Text="{Binding ProfileHeading}"
                    FontFamily="{StaticResource PlayfulGeometricDisplay}"
                    FontSize="27"
                    FontWeight="Bold"/>

                <TextBlock
                    Text="{Binding ProfileDescription}"
                    Foreground="#78716C"
                    Margin="0,7,12,0"
                    TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <!-- Tìm kiếm -->
        <Border Grid.Row="1"
                Style="{StaticResource Card}"
                Padding="16"
                Margin="0,0,6,18">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox
                    ToolTip="Tìm theo mã hoặc họ tên"
                    Text="{Binding SearchText,
                        UpdateSourceTrigger=PropertyChanged}"
                    Margin="0,0,12,0"/>

                <Button Grid.Column="1"
                        Content="Tìm kiếm"
                        Command="{Binding SearchCommand}"
                        Margin="0,0,10,0"/>

                <Button Grid.Column="2"
                        Content="Tải lại"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource Secondary}"/>
            </Grid>
        </Border>

        <!-- Danh sách và chi tiết -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.6*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Danh sách sinh viên -->
            <Border Style="{StaticResource Card}"
                    Padding="0"
                    Margin="0,0,0,6">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="DANH SÁCH HỒ SƠ"
                               Foreground="#78716C"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Margin="20"/>

                    <DataGrid
                        Grid.Row="1"
                        ItemsSource="{Binding DashboardStudents}"
                        SelectedItem="{Binding SelectedStudent, Mode=TwoWay}"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        HorizontalScrollBarVisibility="Auto">

                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Header="Mã SV"
                                Binding="{Binding StudentCode}"
                                Width="100"/>

                            <DataGridTextColumn
                                Header="Họ và tên"
                                Binding="{Binding FullName}"
                                Width="*"
                                MinWidth="160"/>

                            <DataGridTextColumn
                                Header="Ngành học"
                                Binding="{Binding MajorName}"
                                Width="170"/>

                            <DataGridTextColumn
                                Header="Trạng thái"
                                Binding="{Binding StudentStatus}"
                                Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Chi tiết sinh viên đang chọn -->
            <Border Grid.Column="2"
                    Style="{StaticResource Card}"
                    Margin="0,0,6,6">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="CHI TIẾT SINH VIÊN"
                                   Style="{StaticResource Label}"/>

                        <Border Background="#FFF0DF"
                                BorderBrush="#252B3A"
                                BorderThickness="2"
                                CornerRadius="12"
                                Padding="16"
                                Margin="0,10,0,22">

                            <StackPanel>
                                <TextBlock
                                    Text="{Binding SelectedStudent.FullName,
                                        TargetNullValue='Chọn một hồ sơ'}"
                                    FontSize="21"
                                    FontWeight="Bold"
                                    TextWrapping="Wrap"/>

                                <TextBlock
                                    Text="{Binding SelectedStudent.StudentCode}"
                                    Foreground="#C2410C"
                                    FontWeight="SemiBold"
                                    Margin="0,7,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Thông tin cá nhân -->
                        <TextBlock Text="Ngày sinh"
                                   Style="{StaticResource Label}"/>

                        <TextBlock
                            Text="{Binding SelectedStudent.DateOfBirth,
                                StringFormat=dd/MM/yyyy,
                                TargetNullValue='Chưa cập nhật'}"
                            Margin="0,0,0,18"/>

                        <TextBlock Text="Giới tính"
                                   Style="{StaticResource Label}"/>

                        <TextBlock
                            Text="{Binding SelectedStudent.Gender,
                                TargetNullValue='Chưa cập nhật'}"
                            Margin="0,0,0,18"/>

                        <TextBlock Text="Email"
                                   Style="{StaticResource Label}"/>

                        <TextBlock
                            Text="{Binding SelectedStudent.Email,
                                TargetNullValue='Chưa cập nhật'}"
                            TextWrapping="Wrap"
                            Margin="0,0,0,18"/>

                        <TextBlock Text="Điện thoại"
                                   Style="{StaticResource Label}"/>

                        <TextBlock
                            Text="{Binding SelectedStudent.Phone,
                                TargetNullValue='Chưa cập nhật'}"
                            Margin="0,0,0,18"/>

                        <TextBlock Text="Địa chỉ"
                                   Style="{StaticResource Label}"/>

                        <TextBlock
                            Text="{Binding SelectedStudent.Address,
                                TargetNullValue='Chưa cập nhật'}"
                            TextWrapping="Wrap"
                            Margin="0,0,0,18"/>

                        <!-- Thông tin học vụ -->
                        <TextBlock Text="Khoa"
                                   Style="{StaticResource Label}"/>

                        <TextBlock
                            Text="{Binding SelectedStudent.DepartmentName,
                                TargetNullValue='Chưa cập nhật'}"
                            TextWrapping="Wrap"
                            Margin="0,0,0,18"/>

                        <TextBlock Text="Mã ngành"
                                   Style="{StaticResource Label}"/>

                        <TextBlock
                            Text="{Binding SelectedStudent.MajorCode,
                                TargetNullValue='Chưa cập nhật'}"
                            Margin="0,0,0,18"/>

                        <TextBlock Text="Ngành học"
                                   Style="{StaticResource Label}"/>

                        <TextBlock
                            Text="{Binding SelectedStudent.MajorName,
                                TargetNullValue='Chưa cập nhật'}"
                            TextWrapping="Wrap"
                            Margin="0,0,0,18"/>

                        <TextBlock Text="Khóa tuyển sinh"
                                   Style="{StaticResource Label}"/>

                        <TextBlock
                            Text="{Binding SelectedStudent.Cohort,
                                TargetNullValue='Chưa cập nhật'}"
                            Margin="0,0,0,18"/>

                        <TextBlock Text="Ngày nhập học"
                                   Style="{StaticResource Label}"/>

                        <TextBlock
                            Text="{Binding SelectedStudent.EnrollmentDate,
                                StringFormat=dd/MM/yyyy,
                                TargetNullValue='Chưa cập nhật'}"
                            Margin="0,0,0,18"/>

                        <TextBlock Text="Trạng thái học tập"
                                   Style="{StaticResource Label}"/>

                        <TextBlock
                            Text="{Binding SelectedStudent.StudentStatus,
                                TargetNullValue='Chưa cập nhật'}"
                            Margin="0,0,0,18"/>

                        <!-- Liên hệ khẩn cấp -->
                        <TextBlock Text="Người liên hệ khẩn cấp"
                                   Style="{StaticResource Label}"/>

                        <TextBlock
                            Text="{Binding SelectedStudent.EmergencyContactName,
                                TargetNullValue='Chưa cập nhật'}"
                            TextWrapping="Wrap"
                            Margin="0,0,0,18"/>

                        <TextBlock Text="Số điện thoại liên hệ khẩn cấp"
                                   Style="{StaticResource Label}"/>

                        <TextBlock
                            Text="{Binding SelectedStudent.EmergencyContactPhone,
                                TargetNullValue='Chưa cập nhật'}"
                            Margin="0,0,0,22"/>

                        <!-- Giữ các command hiện tại -->
                        <Button Content="Chỉnh sửa hồ sơ"
                                Command="{Binding EditStudentCommand}"/>

                        <Button
                            Content="Hồ sơ học vụ"
                            Command="{Binding ViewRecordsCommand}"
                            Style="{StaticResource Secondary}"
                            Margin="0,10,0,0"
                            Visibility="{Binding CanManageStudents,
                                Converter={StaticResource BoolVisibility}}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3"
                   Text="{Binding DashboardResultMessage}"
                   Foreground="#78716C"
                   FontSize="12"
                   Margin="0,14,0,0"/>
    </Grid>
</Page>