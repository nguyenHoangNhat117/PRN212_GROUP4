<Window x:Class="PRN212_GROUP4.Views.StudentRecordsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Records"
        Width="1100"
        Height="720"
        MinWidth="850"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#F6F5F2"
        FontFamily="Segoe UI"
        UseLayoutRounding="True">

    <Window.Resources>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E8E3DD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#C2410C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#C2410C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">

                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>

                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#292524"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#756E66"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,16,0,5"/>
        </Style>

        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#292524"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F5F3EF"/>
            <Setter Property="Foreground" Value="#655E57"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#3E3934"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                Padding="12,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="BorderBrush" Value="#F0ECE6"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF6ED"/>
                </Trigger>

                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFE8D6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Student records"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#292524"/>

            <StackPanel Orientation="Horizontal"
                        Margin="0,8,0,0">

                <TextBlock Text="{Binding Student.StudentCode}"
                           FontWeight="SemiBold"
                           Foreground="#A9380A"/>

                <TextBlock Text=" — "
                           Foreground="#756E66"/>

                <TextBlock Text="{Binding Student.FullName}"
                           Foreground="#655E57"/>
            </StackPanel>
        </StackPanel>

        <!-- TOOLBAR -->
        <Grid x:Name="ToolbarPanel"
              Grid.Row="1"
              Margin="0,0,0,18"
              IsEnabled="{Binding CanInteract}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <CheckBox Content="Include archived records"
                      IsChecked="{Binding IncludeArchived,
                                          Mode=TwoWay,
                                          UpdateSourceTrigger=PropertyChanged}"
                      Command="{Binding RefreshCommand}"
                      Foreground="#3E3934"
                      FontSize="13"
                      VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Margin="12,0,0,0">

                <Button Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource ActionButton}"
                        Background="White"
                        Foreground="#3E3934"
                        BorderBrush="#DED7CE"
                        Margin="0,0,10,0"/>

                <Button Content="Edit Record"
                        Command="{Binding EditRecordCommand}"
                        Style="{StaticResource ActionButton}"
                        Background="#F0EDE8"
                        Foreground="#3E3934"
                        BorderBrush="#DED7CE"
                        Margin="0,0,10,0"/>

                <Button Content="Archive"
                        Command="{Binding ArchiveRecordCommand}"
                        Style="{StaticResource ActionButton}"
                        Background="#FFF0E5"
                        Foreground="#9A3412"
                        BorderBrush="#FED7AA"
                        Margin="0,0,10,0"/>

                <Button Content="+ Add Record"
                        Command="{Binding AddRecordCommand}"
                        Style="{StaticResource ActionButton}"/>
            </StackPanel>
        </Grid>

        <!-- CONTENT -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="310"/>
            </Grid.ColumnDefinitions>

            <!-- RECORD LIST -->
            <Border Grid.Column="0"
                    Style="{StaticResource Card}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Record history"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="#292524"
                               Margin="0,0,0,18"/>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Records}"
                              SelectedItem="{Binding SelectedRecord,
                                                     Mode=TwoWay}"
                              IsEnabled="{Binding CanInteract}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              RowHeaderWidth="0"
                              RowHeight="50"
                              ColumnHeaderHeight="44"
                              BorderThickness="0"
                              Background="White"
                              RowBackground="White"
                              AlternatingRowBackground="#FCFBF9"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">

                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Header="DATE"
                                Binding="{Binding RecordDate,
                                                  StringFormat={}{0:dd/MM/yyyy}}"
                                Width="110"/>

                            <DataGridTextColumn
                                Header="TYPE"
                                Binding="{Binding RecordType}"
                                Width="120"/>

                            <DataGridTextColumn
                                Header="TITLE"
                                Binding="{Binding RecordTitle}"
                                Width="*"
                                MinWidth="160"/>

                            <DataGridTextColumn
                                Header="STATUS"
                                Binding="{Binding ArchiveStatus}"
                                Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- RECORD DETAILS -->
            <Border Grid.Column="2"
                    Style="{StaticResource Card}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Record details"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="#292524"
                               Margin="0,0,0,18"/>

                    <Grid Grid.Row="1">

                        <!-- EMPTY SELECTION -->
                        <TextBlock
                            Text="Select a record to view its details."
                            Foreground="#756E66"
                            FontSize="13"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center">

                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>

                                    <Style.Triggers>
                                        <DataTrigger
                                            Binding="{Binding SelectedRecord}"
                                            Value="{x:Null}">
                                            <Setter Property="Visibility"
                                                    Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- SELECTED RECORD -->
                        <ScrollViewer
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">

                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility"
                                            Value="Visible"/>

                                    <Style.Triggers>
                                        <DataTrigger
                                            Binding="{Binding SelectedRecord}"
                                            Value="{x:Null}">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>

                            <StackPanel Margin="0,0,8,0">
                                <Border Background="#FFF0E5"
                                        CornerRadius="10"
                                        Padding="14">

                                    <TextBlock
                                        Text="{Binding SelectedRecord.RecordTitle}"
                                        Style="{StaticResource DetailValue}"
                                        FontSize="18"/>
                                </Border>

                                <TextBlock Text="Record type"
                                           Style="{StaticResource DetailLabel}"/>

                                <TextBlock
                                    Text="{Binding SelectedRecord.RecordType}"
                                    Style="{StaticResource DetailValue}"/>

                                <TextBlock Text="Record date"
                                           Style="{StaticResource DetailLabel}"/>

                                <TextBlock
                                    Text="{Binding SelectedRecord.RecordDate,
                                                   StringFormat={}{0:dd/MM/yyyy}}"
                                    Style="{StaticResource DetailValue}"/>

                                <TextBlock Text="Status"
                                           Style="{StaticResource DetailLabel}"/>

                                <TextBlock
                                    Text="{Binding SelectedRecord.ArchiveStatus}"
                                    Style="{StaticResource DetailValue}"/>

                                <TextBlock Text="Content"
                                           Style="{StaticResource DetailLabel}"/>

                                <TextBlock
                                    Text="{Binding SelectedRecord.RecordContent,
                                                   TargetNullValue='No content'}"
                                    Foreground="#3E3934"
                                    FontSize="14"
                                    TextWrapping="Wrap"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- STATUS -->
        <TextBlock x:Name="LoadStatus"
                   Grid.Row="3"
                   Text="{Binding StatusMessage}"
                   TextWrapping="Wrap"
                   Foreground="#756E66"
                   FontSize="12"
                   Margin="0,16,0,0"/>
    </Grid>
</Window>