<Window x:Class="PRN212_GROUP4.Views.StudentRecordsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Records"
        Width="1100"
        Height="720"
        MinWidth="850"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#FFFDF5"
        FontFamily="{StaticResource PlayfulGeometricReading}"
        UseLayoutRounding="True">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <StackPanel Margin="0,0,0,20">
            <TextBlock
                Text="Student records"
                FontFamily="{StaticResource PlayfulGeometricDisplay}"
                FontSize="26"
                FontWeight="Bold"
                Foreground="#253044"/>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="{Binding Student.StudentCode}"
                           FontWeight="SemiBold"
                           Foreground="#A9380A"/>

                <TextBlock Text=" — " Foreground="#756E66"/>

                <TextBlock Text="{Binding Student.FullName}"
                           Foreground="#655E57"/>
            </StackPanel>
        </StackPanel>

        <!-- Thanh công cụ -->
        <Grid x:Name="ToolbarPanel"
              Grid.Row="1"
              Margin="0,0,0,18"
              IsEnabled="{Binding CanInteract}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <CheckBox
                Content="Include archived records"
                IsChecked="{Binding IncludeArchived,
                    Mode=TwoWay,
                    UpdateSourceTrigger=PropertyChanged}"
                Command="{Binding RefreshCommand}"
                Foreground="#3E3934"
                FontSize="13"
                VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Margin="12,0,0,0">

                <Button Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource ActionButton}"
                        Background="White"
                        Foreground="#3E3934"
                        BorderBrush="#9298A4"
                        Margin="0,0,10,0"/>

                <Button Content="Edit Record"
                        Command="{Binding EditRecordCommand}"
                        Style="{StaticResource ActionButton}"
                        Background="#FFF0DF"
                        Foreground="#3E3934"
                        BorderBrush="#9298A4"
                        Margin="0,0,10,0"/>

                <Button Content="Archive"
                        Command="{Binding ArchiveRecordCommand}"
                        Style="{StaticResource ActionButton}"
                        Background="#FFF0DF"
                        Foreground="#9A3412"
                        BorderBrush="#FED7AA"
                        Margin="0,0,10,0"/>

                <Button Content="+ Add Record"
                        Command="{Binding AddRecordCommand}"
                        Style="{StaticResource ActionButton}"/>
            </StackPanel>
        </Grid>

        <!-- Nội dung -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="310"/>
            </Grid.ColumnDefinitions>

            <!-- Bảng lịch sử -->
            <Border Grid.Column="0"
                    Style="{StaticResource Card}"
                    Margin="0,0,0,6">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Record history"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="#253044"
                               Margin="0,0,0,18"/>

                    <DataGrid
                        Grid.Row="1"
                        ItemsSource="{Binding Records}"
                        SelectedItem="{Binding SelectedRecord, Mode=TwoWay}"
                        IsEnabled="{Binding CanInteract}"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserResizeRows="False"
                        SelectionMode="Single"
                        SelectionUnit="FullRow"
                        HeadersVisibility="Column"
                        GridLinesVisibility="None"
                        RowHeaderWidth="0"
                        RowHeight="50"
                        ColumnHeaderHeight="44"
                        BorderThickness="0"
                        Background="White"
                        RowBackground="White"
                        AlternatingRowBackground="#FCFBF9"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto">

                        <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã chứng từ" Binding="{Binding DocumentNumber}" Width="120"/>
                            <DataGridTextColumn
                                Header="DATE"
                                Binding="{Binding RecordDate,
                                    StringFormat={}{0:dd/MM/yyyy}}"
                                Width="110"/>

                            <DataGridTextColumn
                                Header="TYPE"
                                Binding="{Binding RecordType}"
                                Width="120"/>

                            <DataGridTextColumn
                                Header="TITLE"
                                Binding="{Binding RecordTitle}"
                                Width="*"
                                MinWidth="160"/>

                            <DataGridTextColumn
                                Header="STATUS"
                                Binding="{Binding ArchiveStatus}"
                                Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Chi tiết -->
            <Border Grid.Column="2"
                    Style="{StaticResource Card}"
                    Margin="0,0,6,6">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Record details"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="#253044"
                               Margin="0,0,0,18"/>

                    <Grid Grid.Row="1">

                        <!-- Chưa chọn hồ sơ -->
                        <TextBlock
                            Text="Select a record to view its details."
                            Foreground="#756E66"
                            FontSize="13"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center">

                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>

                                    <Style.Triggers>
                                        <DataTrigger
                                            Binding="{Binding SelectedRecord}"
                                            Value="{x:Null}">
                                            <Setter Property="Visibility"
                                                    Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Hồ sơ đã chọn -->
                        <ScrollViewer
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">

                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility"
                                            Value="Visible"/>

                                    <Style.Triggers>
                                        <DataTrigger
                                            Binding="{Binding SelectedRecord}"
                                            Value="{x:Null}">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>

                            <StackPanel Margin="0,0,8,0">
                                <Border Background="#FFF0DF"
                                        CornerRadius="10"
                                        Padding="14">

                                    <TextBlock
                                        Text="{Binding SelectedRecord.RecordTitle}"
                                        Style="{StaticResource DetailValue}"
                                        FontSize="18"/>
                                </Border>

                                <TextBlock Text="Record type"
                                           Style="{StaticResource DetailLabel}"/>

                                <TextBlock
                                    Text="{Binding SelectedRecord.RecordType}"
                                    Style="{StaticResource DetailValue}"/>

                                <TextBlock Text="Record date"
                                           Style="{StaticResource DetailLabel}"/>

                                <TextBlock
                                    Text="{Binding SelectedRecord.RecordDate,
                                        StringFormat={}{0:dd/MM/yyyy}}"
                                    Style="{StaticResource DetailValue}"/>

                                <TextBlock Text="Status"
                                           Style="{StaticResource DetailLabel}"/>

                                <TextBlock
                                    Text="{Binding SelectedRecord.ArchiveStatus}"
                                    Style="{StaticResource DetailValue}"/>

                                <TextBlock Text="Content"
                                           Style="{StaticResource DetailLabel}"/>

                                <TextBlock
                                    Text="{Binding SelectedRecord.RecordContent,
                                        TargetNullValue='No content'}"
                                    Foreground="#3E3934"
                                    FontSize="14"
                                    TextWrapping="Wrap"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <TextBlock x:Name="LoadStatus"
                   Grid.Row="3"
                   Text="{Binding StatusMessage}"
                   TextWrapping="Wrap"
                   Foreground="#756E66"
                   FontSize="12"
                   Margin="0,16,0,0"/>
    </Grid>
</Window>