<Window x:Class="PRN212_GROUP4.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đổi mật khẩu"
        Width="480"
        Height="600"
        MinWidth="440"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#FFFDF5"
        FontFamily="{StaticResource PlayfulGeometricReading}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource Card}" Margin="24">
            <StackPanel x:Name="FormPanel" Margin="0">

                <TextBlock Text="BẢO MẬT TÀI KHOẢN"
                           Foreground="#C2410C"
                           FontSize="11"
                           FontWeight="Bold"/>

                <TextBlock
                    Text="Đổi mật khẩu"
                    FontFamily="{StaticResource PlayfulGeometricDisplay}"
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="#253044"
                    Margin="0,10,0,8"/>

                <TextBlock
                    x:Name="Description"
                    Text="Cập nhật mật khẩu cho tài khoản đang đăng nhập."
                    TextWrapping="Wrap"
                    Foreground="#78716C"
                    Margin="0,0,0,24"/>

                <StackPanel x:Name="CurrentPasswordPanel">
                    <TextBlock Text="Mật khẩu hiện tại"
                               Style="{StaticResource Label}"/>

                    <PasswordBox x:Name="CurrentPassword"
                                 Margin="0,0,0,18"/>
                </StackPanel>

                <TextBlock Text="Mật khẩu mới (6–128 ký tự)"
                           Style="{StaticResource Label}"/>

                <PasswordBox x:Name="NewPassword"
                             Margin="0,0,0,18"/>

                <TextBlock Text="Xác nhận mật khẩu mới"
                           Style="{StaticResource Label}"/>

                <PasswordBox x:Name="Confirmation"
                             Margin="0,0,0,20"/>

                <TextBlock x:Name="Message"
                           Foreground="#B91C1C"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16"/>

                <Button Content="Lưu mật khẩu mới"
                        Click="Save_Click"
                        IsDefault="True"/>

                <Button x:Name="CancelButton"
                        Content="Hủy"
                        Click="Cancel_Click"
                        Style="{StaticResource Secondary}"
                        Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>