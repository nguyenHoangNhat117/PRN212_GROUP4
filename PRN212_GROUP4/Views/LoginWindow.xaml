<Window x:Class="PRN212_GROUP4.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng nhập · Student Management"
        Width="960"
        Height="720"
        MinWidth="880"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#FFF8EE"
        FontFamily="{StaticResource PlayfulGeometricReading}"
        UseLayoutRounding="True">

    <Grid Margin="22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.95*"/>
            <ColumnDefinition Width="1.05*"/>
        </Grid.ColumnDefinitions>

        <!-- Bảng minh họa trường học -->
        <Border CornerRadius="24"
                Padding="28"
                Background="#FFD4A6"
                BorderBrush="#252B3A"
                BorderThickness="3"
                Margin="0,0,8,0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="100"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="86"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="CAMPUS / GROUP 04"
                           Foreground="#253044"
                           FontWeight="SemiBold"
                           FontSize="14"/>

                <!-- Mũ tốt nghiệp -->
                <Viewbox Grid.Row="1"
                         Width="130"
                         Height="90"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         IsHitTestVisible="False">

                    <Canvas Width="130" Height="90">

                        <!-- Thân mũ -->
                        <Path Data="M30,42
                                    L30,63
                                    Q65,85 100,63
                                    L100,42
                                    L65,56 Z"
                              Fill="#F97316"
                              Stroke="#252B3A"
                              StrokeThickness="3"
                              StrokeLineJoin="Round"/>

                        <!-- Mặt trên -->
                        <Path Data="M6,30
                                    L65,6
                                    L124,30
                                    L65,54 Z"
                              Fill="#FFB347"
                              Stroke="#252B3A"
                              StrokeThickness="3"
                              StrokeLineJoin="Round"/>

                        <!-- Dây tua -->
                        <Path Data="M65,30
                                    L124,30
                                    L124,68"
                              Stroke="#252B3A"
                              StrokeThickness="3"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"/>

                        <Ellipse Canvas.Left="120"
                                 Canvas.Top="65"
                                 Width="8"
                                 Height="12"
                                 Fill="#F97316"
                                 Stroke="#252B3A"
                                 StrokeThickness="2"/>
                    </Canvas>
                </Viewbox>

                <!-- Nội dung chính -->
                <StackPanel Grid.Row="2"
                            VerticalAlignment="Center"
                            Margin="0,8,0,12">

                    <TextBlock
                        Text="Học tập.&#10;Kết nối.&#10;Tiến xa."
                        FontFamily="{StaticResource PlayfulGeometricDisplay}"
                        FontSize="40"
                        FontWeight="Bold"
                        Foreground="#253044"
                        LineHeight="48"
                        LineStackingStrategy="BlockLineHeight"/>

                    <TextBlock
                        Text="Không gian quản lý sinh viên và học vụ của bạn."
                        Foreground="#71320D"
                        FontSize="15"
                        TextWrapping="Wrap"
                        Margin="0,18,0,0"
                        LineHeight="24"/>
                </StackPanel>

                <!-- Sách và bút chì -->
                <Grid Grid.Row="3"
                      Margin="0,0,0,8"
                      IsHitTestVisible="False">

                    <!-- Sách mở -->
                    <Viewbox Width="104"
                             Height="76"
                             HorizontalAlignment="Left">

                        <Canvas Width="104" Height="76">

                            <!-- Bóng sách -->
                            <Path Data="M8,10
                                        Q30,4 53,17
                                        Q76,4 98,10
                                        L98,59
                                        Q76,54 53,67
                                        Q30,54 8,59 Z"
                                  Fill="#252B3A"/>

                            <!-- Trang trái -->
                            <Path Data="M4,5
                                        Q25,-1 49,12
                                        L49,62
                                        Q25,49 4,54 Z"
                                  Fill="White"
                                  Stroke="#252B3A"
                                  StrokeThickness="3"
                                  StrokeLineJoin="Round"/>

                            <!-- Trang phải -->
                            <Path Data="M49,12
                                        Q72,-1 94,5
                                        L94,54
                                        Q72,49 49,62 Z"
                                  Fill="#FFFDF5"
                                  Stroke="#252B3A"
                                  StrokeThickness="3"
                                  StrokeLineJoin="Round"/>

                            <!-- Các dòng chữ -->
                            <Path Data="M14,20 Q28,18 39,25
                                        M14,31 Q28,29 39,36
                                        M60,25 Q73,18 84,20
                                        M60,36 Q73,29 84,31"
                                  Stroke="#C2410C"
                                  StrokeThickness="2.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>
                        </Canvas>
                    </Viewbox>

                    <!-- Bút chì -->
                    <Viewbox Width="64"
                             Height="78"
                             HorizontalAlignment="Right">

                        <Canvas Width="66" Height="80">

                            <!-- Thân bút -->
                            <Path Data="M11,52
                                        L42,8
                                        L58,20
                                        L27,64 Z"
                                  Fill="#FFB347"
                                  Stroke="#252B3A"
                                  StrokeThickness="3"
                                  StrokeLineJoin="Round"/>

                            <Path Data="M19,58 L50,14"
                                  Stroke="#C2410C"
                                  StrokeThickness="2"/>

                            <!-- Đầu gỗ -->
                            <Path Data="M11,52
                                        L27,64
                                        L5,75 Z"
                                  Fill="#FFE4C7"
                                  Stroke="#252B3A"
                                  StrokeThickness="3"
                                  StrokeLineJoin="Round"/>

                            <!-- Ngòi -->
                            <Path Data="M5,75 L9,62 L17,69 Z"
                                  Fill="#252B3A"/>

                            <!-- Cục tẩy -->
                            <Path Data="M42,8
                                        L47,1
                                        Q49,-1 52,1
                                        L63,9
                                        Q65,11 63,14
                                        L58,20 Z"
                                  Fill="#F97316"
                                  Stroke="#252B3A"
                                  StrokeThickness="3"
                                  StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                </Grid>

                <TextBlock Grid.Row="4"
                           Text="STUDENT MANAGEMENT SYSTEM"
                           Foreground="#71320D"
                           FontSize="10"
                           Margin="0,10,0,0"/>
            </Grid>
        </Border>

        <!-- Form đăng nhập -->
        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="30,40,14,24"
                        VerticalAlignment="Center">

                <Border Background="#FFE8CF"
                        BorderBrush="#252B3A"
                        BorderThickness="1.5"
                        CornerRadius="9"
                        Padding="10,6"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,16">

                    <TextBlock Text="CHÀO MỪNG TRỞ LẠI"
                               Foreground="#9A3412"
                               FontSize="11"
                               FontWeight="Bold"/>
                </Border>

                <TextBlock
                    Text="Đăng nhập"
                    FontFamily="{StaticResource PlayfulGeometricDisplay}"
                    FontSize="34"
                    FontWeight="Bold"
                    Foreground="#253044"
                    Margin="0,0,0,10"/>

                <TextBlock
                    Text="Truy cập hồ sơ và thông tin học tập của bạn."
                    Foreground="#596274"
                    FontSize="14"
                    TextWrapping="Wrap"
                    Margin="0,0,0,30"/>

                <TextBlock Text="Tài khoản"
                           Style="{StaticResource Label}"/>

                <TextBox x:Name="Username"
                         Margin="0,0,0,20"
                         MinHeight="46"/>

                <TextBlock Text="Mật khẩu"
                           Style="{StaticResource Label}"/>

                <PasswordBox x:Name="Password"
                             Margin="0,0,0,26"
                             MinHeight="46"/>

                <Button x:Name="LoginButton"
                        Content="Đăng nhập   →"
                        Click="Login_Click"
                        IsDefault="True"
                        Height="50"
                        Background="#F97316"
                        Foreground="#253044"
                        BorderBrush="#252B3A"
                        FontWeight="Bold"/>

                <TextBlock x:Name="Message"
                           Foreground="#B91C1C"
                           TextWrapping="Wrap"
                           Margin="0,16,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>