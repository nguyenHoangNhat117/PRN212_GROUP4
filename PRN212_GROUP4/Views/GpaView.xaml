<Page x:Class="PRN212_GROUP4.Views.GpaView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#FFFDF5"
      FontFamily="{StaticResource PlayfulGeometricReading}"
      Foreground="#253044">

    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock
                Text="GPA"
                FontFamily="{StaticResource PlayfulGeometricDisplay}"
                FontSize="27"
                FontWeight="Bold"/>

            <TextBlock
                Text="GPA học kỳ và tích lũy, tính từ điểm đã công bố của các môn đã hoàn thành."
                Foreground="#78716C"
                Margin="0,7,0,0"
                TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Chọn sinh viên + kết quả -->
        <Border Grid.Row="1"
                Style="{StaticResource Card}"
                Padding="16"
                Margin="0,0,6,18"
                IsEnabled="{Binding CanInteract}">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Sinh viên"
                                   Style="{StaticResource Label}"/>
                        <ComboBox Width="280"
                                  ItemsSource="{Binding Students}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding StudentId}"/>
                    </StackPanel>

                    <Button Content="Tải lại"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource Secondary}"
                            VerticalAlignment="Bottom"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right">
                    <TextBlock Text="GPA TÍCH LŨY"
                               Foreground="#C2410C"
                               FontSize="11"
                               FontWeight="Bold"
                               HorizontalAlignment="Right"/>

                    <TextBlock Text="{Binding CumulativeText}"
                               FontFamily="{StaticResource PlayfulGeometricDisplay}"
                               FontSize="30"
                               FontWeight="Bold"
                               HorizontalAlignment="Right"/>

                    <TextBlock Text="{Binding CreditsText}"
                               Foreground="#78716C"
                               FontSize="11"
                               HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2"
                   Text="{Binding Note}"
                   Foreground="#9A3412"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Margin="0,0,6,12"/>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.8*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="1.6*"/>
            </Grid.ColumnDefinitions>

            <!-- GPA từng học kỳ -->
            <Border Style="{StaticResource Card}"
                    Padding="0"
                    Margin="0,0,0,6">

                <DataGrid ItemsSource="{Binding Semesters}"
                          AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Học kỳ"
                                            Binding="{Binding Semester}"
                                            Width="1.2*"/>
                        <DataGridTextColumn Header="GPA học kỳ"
                                            Binding="{Binding GpaText}"
                                            Width="1.2*"/>
                        <DataGridTextColumn Header="Tín chỉ"
                                            Binding="{Binding Credits}"
                                            Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Các môn được tính -->
            <Border Grid.Column="2"
                    Style="{StaticResource Card}"
                    Padding="0"
                    Margin="0,0,6,6">

                <DataGrid ItemsSource="{Binding Courses}"
                          AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Học kỳ"
                                            Binding="{Binding Semester}"
                                            Width="100"/>
                        <DataGridTextColumn Header="Môn học"
                                            Binding="{Binding Course}"
                                            Width="1.6*"/>
                        <DataGridTextColumn Header="Tín chỉ"
                                            Binding="{Binding Credits}"
                                            Width="70"/>
                        <DataGridTextColumn Header="Điểm"
                                            Binding="{Binding ScoreText}"
                                            Width="65"/>
                        <DataGridTextColumn Header="Chữ"
                                            Binding="{Binding Letter}"
                                            Width="55"/>
                        <DataGridTextColumn Header="Hệ 4"
                                            Binding="{Binding PointText}"
                                            Width="65"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="4" Margin="0,14,0,0">
            <TextBlock Text="{Binding Message}"
                       Foreground="#78716C"
                       TextWrapping="Wrap"/>

            <TextBlock Text="{Binding ScaleText}"
                       Foreground="#78716C"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0"/>
        </StackPanel>
    </Grid>
</Page>