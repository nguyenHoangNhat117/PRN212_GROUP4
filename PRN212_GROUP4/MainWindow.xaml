<Window x:Class="PRN212_GROUP4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StudentHub | Student Management"
        Width="1440"
        Height="860"
        MinWidth="1120"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#F6F5F2"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>

        <!-- BANNER -->
        <LinearGradientBrush x:Key="HeroGradient"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#C2410C" Offset="0"/>
            <GradientStop Color="#B94A10" Offset="0.65"/>
            <GradientStop Color="#A83A11" Offset="1"/>
        </LinearGradientBrush>

        <!-- SIDEBAR BUTTON -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="12,3"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Foreground" Value="#D1CCC6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">

                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#35312E"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>

                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#FDBA74"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.78"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ACTION BUTTON -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#C2410C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBackground"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">

                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBackground"
                                        Property="Opacity"
                                        Value="0.85"/>
                            </Trigger>

                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#FDBA74"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.78"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- STAT CARD -->
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderBrush" Value="#E8E3DD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
        </Style>

        <!-- DATA GRID -->
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="RowHeight" Value="52"/>
            <Setter Property="ColumnHeaderHeight" Value="46"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FCFBF9"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F5F3EF"/>
            <Setter Property="Foreground" Value="#655E57"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#3E3934"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="BorderBrush" Value="#F0ECE6"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF6ED"/>
                </Trigger>

                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFE8D6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- STUDENT STATUS -->
        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="Background" Value="#F0EDE8"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>

            <Style.Triggers>
                <DataTrigger Binding="{Binding StudentStatus}" Value="ACTIVE">
                    <Setter Property="Background" Value="#E9F3ED"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding StudentStatus}" Value="GRADUATED">
                    <Setter Property="Background" Value="#FFF0E5"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding StudentStatus}" Value="SUSPENDED">
                    <Setter Property="Background" Value="#FCECE8"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="#24211F">
            <DockPanel LastChildFill="True">

                <!-- GROUP INFO -->
                <Border DockPanel.Dock="Bottom"
                        BorderBrush="#45403B"
                        BorderThickness="0,1,0,0"
                        Padding="20">

                    <StackPanel Orientation="Horizontal">
                        <Border Width="39"
                                Height="39"
                                CornerRadius="12"
                                Background="#C2410C">

                            <TextBlock Text="G4"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Margin="12,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="PRN212 - Group 4"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       FontSize="12"/>

                            <TextBlock Text="Student Management"
                                       Foreground="#BEB6AD"
                                       FontSize="11"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- LOGO -->
                        <StackPanel Margin="25,34,15,38">
                            <TextBlock Text="StudentHub."
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="ACADEMIC MANAGEMENT"
                                       Foreground="#BEB6AD"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Margin="2,8,0,0"/>
                        </StackPanel>

                        <TextBlock Text="WORKSPACE"
                                   Foreground="#BEB6AD"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Margin="28,0,0,12"/>

                        <!-- DASHBOARD -->
                        <Button x:Name="DashboardButton"
                                Click="DashboardButton_Click"
                                Style="{StaticResource NavButton}"
                                Background="#C2410C"
                                Foreground="White">

                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE80F;"
                                           Width="28"
                                           FontSize="16"
                                           VerticalAlignment="Center"/>

                                <TextBlock Text="Dashboard"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- STUDENTS -->
                        <Button x:Name="StudentsButton"
                                Click="StudentsButton_Click"
                                Style="{StaticResource NavButton}">

                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE716;"
                                           Width="28"
                                           FontSize="16"
                                           VerticalAlignment="Center"/>

                                <TextBlock Text="Students"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- COURSES -->
                        <Button Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE8F1;"
                                           Width="28"
                                           FontSize="16"
                                           VerticalAlignment="Center"/>

                                <TextBlock Text="Courses"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- CLASSES -->
                        <Button Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE902;"
                                           Width="28"
                                           FontSize="16"
                                           VerticalAlignment="Center"/>

                                <TextBlock Text="Classes"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- ENROLLMENTS -->
                        <Button Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE8A5;"
                                           Width="28"
                                           FontSize="16"
                                           VerticalAlignment="Center"/>

                                <TextBlock Text="Enrollments"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Text="ACADEMIC"
                                   Foreground="#BEB6AD"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Margin="28,28,0,12"/>

                        <!-- GRADES -->
                        <Button Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE734;"
                                           Width="28"
                                           FontSize="16"
                                           VerticalAlignment="Center"/>

                                <TextBlock Text="Grades"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- ACADEMIC PROGRESS -->
                        <Button Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE9D9;"
                                           Width="28"
                                           FontSize="16"
                                           VerticalAlignment="Center"/>

                                <TextBlock Text="Academic Progress"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- REPORTS -->
                        <Button x:Name="ReportsButton"
                            Click="ReportsButton_Click"
                            Style="{StaticResource NavButton}">

                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                    Text="&#xE9F9;"
                                    Width="28"
                                    FontSize="16"
                                    VerticalAlignment="Center"/>

                                <TextBlock Text="Reports"
                                    VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Text="ADMINISTRATION"
                                   Foreground="#BEB6AD"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Margin="28,28,0,12"/>

                        <!-- USER ACCOUNTS -->
                        <Button Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE77B;"
                                           Width="28"
                                           FontSize="16"
                                           VerticalAlignment="Center"/>

                                <TextBlock Text="User Accounts"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- SETTINGS -->
                        <Button Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE713;"
                                           Width="28"
                                           FontSize="16"
                                           VerticalAlignment="Center"/>

                                <TextBlock Text="Settings"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- MAIN AREA -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="76"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#E8E3DD"
                    BorderThickness="0,0,0,1">

                <Grid Margin="32,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock x:Name="PageTitle"
                                   Text="Dashboard"
                                   FontWeight="Bold"
                                   FontSize="20"
                                   Foreground="#292524"/>

                        <TextBlock x:Name="PageSubtitle"
                                   Text="Student Management / Overview"
                                   FontSize="11"
                                   Foreground="#756E66"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Border Width="40"
                                Height="40"
                                Background="#FFF0E5"
                                CornerRadius="20"
                                Margin="0,0,12,0">

                            <TextBlock Text="A"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="#C2410C"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Administrator"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Foreground="#292524"/>

                            <TextBlock Text="System Admin"
                                       FontSize="11"
                                       Foreground="#756E66"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- DASHBOARD CONTENT -->
            <ScrollViewer x:Name="DashboardContent"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">

                <StackPanel Margin="32,28,32,30">

                    <!-- WELCOME BANNER -->
                    <Border Height="174"
                            CornerRadius="18"
                            Background="{StaticResource HeroGradient}">

                        <Grid Margin="30,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">

                                <TextBlock Text="STUDENT MANAGEMENT SYSTEM"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#FFE4D1"/>

                                <TextBlock Text="Your academic workspace."
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           Margin="0,12,0,8"/>

                                <TextBlock
                                    Text="Manage students, courses, classes and academic information in one place."
                                    FontSize="12"
                                    Foreground="#FFF4EB"
                                    TextWrapping="Wrap"
                                    MaxWidth="590"/>
                            </StackPanel>

                            <Grid Grid.Column="1"
                                  ClipToBounds="True"
                                  IsHitTestVisible="False">

                                <Ellipse Width="160"
                                         Height="160"
                                         Stroke="#77FFFFFF"
                                         StrokeThickness="2"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Center"/>

                                <Ellipse Width="110"
                                         Height="110"
                                         Fill="#20FFFFFF"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Center"
                                         Margin="0,0,25,0"/>

                                <Ellipse Width="54"
                                         Height="54"
                                         Fill="#45FFFFFF"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Center"
                                         Margin="0,0,54,0"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <TextBlock Text="Overview at a glance"
                               FontWeight="Bold"
                               FontSize="19"
                               Foreground="#292524"
                               Margin="0,28,0,18"/>

                    <!-- STATISTICS -->
                    <UniformGrid Columns="4" Margin="0,0,-14,0">

                        <!-- STUDENTS -->
                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <Border Background="#FFF0E5"
                                        Width="43"
                                        Height="43"
                                        CornerRadius="12"
                                        HorizontalAlignment="Left">

                                    <TextBlock Text="S"
                                               Foreground="#A9380A"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Text="Total Students"
                                           Foreground="#655E57"
                                           FontSize="12"
                                           Margin="0,15,0,7"/>

                                <TextBlock Text="--"
                                           Foreground="#292524"
                                           FontSize="29"
                                           FontWeight="Bold"/>

                                <TextBlock Text="Student records"
                                           Foreground="#756E66"
                                           FontSize="11"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- COURSES -->
                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <Border Background="#F0EDE8"
                                        Width="43"
                                        Height="43"
                                        CornerRadius="12"
                                        HorizontalAlignment="Left">

                                    <TextBlock Text="C"
                                               Foreground="#57504A"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Text="Total Courses"
                                           Foreground="#655E57"
                                           FontSize="12"
                                           Margin="0,15,0,7"/>

                                <TextBlock Text="--"
                                           Foreground="#292524"
                                           FontSize="29"
                                           FontWeight="Bold"/>

                                <TextBlock Text="Course catalog"
                                           Foreground="#756E66"
                                           FontSize="11"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- CLASSES -->
                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <Border Background="#F0EDE8"
                                        Width="43"
                                        Height="43"
                                        CornerRadius="12"
                                        HorizontalAlignment="Left">

                                    <TextBlock Text="CL"
                                               Foreground="#57504A"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Text="Total Classes"
                                           Foreground="#655E57"
                                           FontSize="12"
                                           Margin="0,15,0,7"/>

                                <TextBlock Text="--"
                                           Foreground="#292524"
                                           FontSize="29"
                                           FontWeight="Bold"/>

                                <TextBlock Text="Academic classes"
                                           Foreground="#756E66"
                                           FontSize="11"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- ENROLLMENTS -->
                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <Border Background="#FFF0E5"
                                        Width="43"
                                        Height="43"
                                        CornerRadius="12"
                                        HorizontalAlignment="Left">

                                    <TextBlock Text="E"
                                               Foreground="#A9380A"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Text="Enrollments"
                                           Foreground="#655E57"
                                           FontSize="12"
                                           Margin="0,15,0,7"/>

                                <TextBlock Text="--"
                                           Foreground="#292524"
                                           FontSize="29"
                                           FontWeight="Bold"/>

                                <TextBlock Text="Course registrations"
                                           Foreground="#756E66"
                                           FontSize="11"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                    </UniformGrid>

                    <!-- STUDENT DIRECTORY -->
                    <Border Background="White"
                            CornerRadius="16"
                            BorderBrush="#E8E3DD"
                            BorderThickness="1"
                            Padding="24"
                            Margin="0,26,0,0">

                        <StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Student directory"
                                               FontSize="19"
                                               FontWeight="Bold"
                                               Foreground="#292524"/>

                                    <TextBlock
                                        Text="Student information and academic records"
                                        Foreground="#756E66"
                                        FontSize="12"
                                        Margin="0,6,0,0"/>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="+  Add Student"
                                        Style="{StaticResource ActionButton}"
                                        VerticalAlignment="Center"/>
                            </Grid>

                            <!-- SEARCH -->
                            <Grid Margin="0,22,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border BorderThickness="1"
                                        CornerRadius="9"
                                        Background="#FCFBF9"
                                        Height="43">

                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush"
                                                    Value="#DED7CE"/>

                                            <Style.Triggers>
                                                <Trigger
                                                    Property="IsKeyboardFocusWithin"
                                                    Value="True">

                                                    <Setter Property="BorderBrush"
                                                            Value="#C2410C"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="&#xE721;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16"
                                                   Foreground="#756E66"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                        <TextBox Grid.Column="1"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 VerticalContentAlignment="Center"
                                                 FontSize="13"
                                                 Foreground="#3E3934"
                                                 Padding="0,0,12,0"
                                                 ToolTip="Search students by ID or name"/>
                                    </Grid>
                                </Border>

                                <Button Grid.Column="1"
                                        Content="Search"
                                        Style="{StaticResource ActionButton}"
                                        Margin="12,0,0,0"
                                        Width="105"/>
                            </Grid>

                            <!-- STUDENT TABLE -->
                            <DataGrid Height="300"
                                      ItemsSource="{Binding Students}">

                                <DataGrid.Columns>

                                    <DataGridTextColumn
                                        Header="STUDENT ID"
                                        Binding="{Binding StudentCode}"
                                        MinWidth="110"
                                        Width="*"/>

                                    <DataGridTextColumn
                                        Header="FULL NAME"
                                        Binding="{Binding FullName}"
                                        MinWidth="170"
                                        Width="2*"/>

                                    <DataGridTextColumn
                                        Header="EMAIL"
                                        Binding="{Binding Email}"
                                        MinWidth="180"
                                        Width="2*"/>

                                    <DataGridTemplateColumn
                                        Header="STATUS"
                                        Width="*"
                                        MinWidth="120">

                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource StatusBadge}">
                                                    <TextBlock
                                                        Text="{Binding StudentStatus, TargetNullValue=—}"
                                                        Foreground="#3E3934"
                                                        FontWeight="SemiBold"
                                                        FontSize="11"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>

                                    </DataGridTemplateColumn>

                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock
                                Text="Student profiles and academic information."
