<Window x:Class="PRN212_GROUP4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Management · Group 04"
        Width="1320"
        Height="840"
        MinWidth="1100"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#FFF8EE"
        FontFamily="{StaticResource PlayfulGeometricReading}"
        Foreground="#253044">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="#FFD4A6"
                BorderBrush="#252B3A"
                BorderThickness="0,0,2,0"
                Padding="20,28">

            <DockPanel>

                <!-- Branding -->
                <StackPanel DockPanel.Dock="Top"
                            Margin="0,0,0,36">

                    <Border Background="#F97316"
                            BorderBrush="#252B3A"
                            BorderThickness="2"
                            CornerRadius="12"
                            Padding="10,8">

                        <TextBlock
                            Text="CAMPUS"
                            FontFamily="{StaticResource PlayfulGeometricDisplay}"
                            Foreground="#253044"
                            FontSize="26"
                            FontWeight="Bold"/>
                    </Border>

                    <TextBlock Text="Student Management / Group 04"
                               Foreground="#596274"
                               FontSize="10"
                               Margin="0,10,0,0"/>
                </StackPanel>

                <!-- Account -->
                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Text="PHIÊN ĐĂNG NHẬP"
                               Foreground="#596274"
                               FontSize="10"
                               Margin="0,0,0,8"/>

                    <TextBlock x:Name="Identity"
                               Foreground="#253044"
                               TextWrapping="Wrap"
                               FontWeight="SemiBold"/>

                    <Button Content="Đổi mật khẩu"
                            Click="ChangePassword_Click"
                            Style="{StaticResource Nav}"
                            Margin="0,16,0,0"/>

                    <Button Content="Đăng xuất"
                            Click="Logout_Click"
                            Style="{StaticResource Nav}"
                            Margin="0,16,0,0"/>
                </StackPanel>

                <!-- Navigation -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="KHÔNG GIAN HỌC VỤ"
                               Foreground="#596274"
                               FontSize="10"
                               Margin="0,0,0,16"/>

                        <Button x:Name="StudentsButton"
                            Content="Hồ sơ sinh viên"
                            Click="Students_Click"
                            Style="{StaticResource Nav}"/>

                        <Button x:Name="EnrollmentButton"
                            Content="Đăng ký môn học"
                            Click="Enrollment_Click"
                            Style="{StaticResource Nav}"/>

                        <Button x:Name="GradesButton"
                            Content="Điểm số"
                            Click="Grades_Click"
                            Style="{StaticResource Nav}"/>

                        <Button x:Name="GpaButton"
                            Content="GPA"
                            Click="Gpa_Click"
                            Style="{StaticResource Nav}"/>

                        <Button x:Name="ProgressButton"
                            Content="Tiến độ học tập"
                            Click="Progress_Click"
                            Style="{StaticResource Nav}"/>

                        <Button x:Name="ReportsButton"
                            Content="Báo cáo học tập"
                            Click="Reports_Click"
                            Style="{StaticResource Nav}"/>
                    </StackPanel>
                </ScrollViewer>

            </DockPanel>
        </Border>

        <!-- Main content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Background="White"
                    BorderBrush="#252B3A"
                    BorderThickness="0,0,0,1"
                    Padding="28,18">

                <DockPanel>
                    <Border DockPanel.Dock="Right"
                            Background="#FFE8CF"
                            CornerRadius="8"
                            Padding="12,7">

                        <TextBlock x:Name="RoleLabel"
                                   Foreground="#9A3412"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                    </Border>

                    <StackPanel>
                        <TextBlock x:Name="PageHeading"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="ScopeLabel"
                                   Foreground="#596274"
                                   FontSize="12"
                                   Margin="0,4,12,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Frame Grid.Row="1"
                   x:Name="MainFrame"
                   NavigationUIVisibility="Hidden"/>
        </Grid>
    </Grid>
</Window>