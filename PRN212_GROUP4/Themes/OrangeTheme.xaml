<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:p="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">

    <BooleanToVisibilityConverter x:Key="BoolVisibility"/>

    <!-- Fonts -->
    <FontFamily x:Key="PlayfulGeometricDisplay">
        Host Grotesk, Segoe UI Variable Display, Segoe UI
    </FontFamily>

    <FontFamily x:Key="PlayfulGeometricReading">
        Instrument Sans, Segoe UI
    </FontFamily>

    <!-- Colors -->
    <SolidColorBrush x:Key="Paper" Color="#FFF8EE"/>
    <SolidColorBrush x:Key="Ink" Color="#253044"/>
    <SolidColorBrush x:Key="Outline" Color="#252B3A"/>
    <SolidColorBrush x:Key="Accent" Color="#F97316"/>
    <SolidColorBrush x:Key="SoftOrange" Color="#FFE8CF"/>

    <!-- Keyboard focus -->
    <Style x:Key="FocusRing" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-5"
                               Stroke="#253044"
                               StrokeThickness="2"
                               StrokeDashArray="2 2"
                               RadiusX="16"
                               RadiusY="16"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Content cards -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="BorderBrush" Value="{StaticResource Outline}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Padding" Value="22"/>

        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#252B3A"
                                  BlurRadius="0"
                                  ShadowDepth="5"
                                  Direction="315"
                                  Opacity="1"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Labels -->
    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="FontFamily"
                Value="{StaticResource PlayfulGeometricReading}"/>
        <Setter Property="Foreground" Value="#596274"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style x:Key="FieldLabel"
           TargetType="TextBlock"
           BasedOn="{StaticResource Label}">
        <Setter Property="Margin" Value="0,16,0,8"/>
    </Style>

    <Style x:Key="DetailLabel"
           TargetType="TextBlock"
           BasedOn="{StaticResource FieldLabel}"/>

    <Style x:Key="DetailValue" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Primary buttons -->
    <Style x:Key="GeoButton" TargetType="Button">
        <Setter Property="FontFamily"
                Value="{StaticResource PlayfulGeometricReading}"/>
        <Setter Property="Background" Value="{StaticResource Accent}"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Outline}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="MinWidth" Value="105"/>
        <Setter Property="Padding" Value="18,10"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle"
                Value="{StaticResource FocusRing}"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Margin="0,0,4,4">

                        <!-- Hard offset shadow -->
                        <Border Background="#252B3A"
                                CornerRadius="13">
                            <Border.RenderTransform>
                                <TranslateTransform X="4" Y="4"/>
                            </Border.RenderTransform>
                        </Border>

                        <Border x:Name="Face"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="13">

                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True"/>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face"
                                    Property="BorderBrush"
                                    Value="#C2410C"/>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face"
                                    Property="Opacity"
                                    Value="0.8"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button"
           BasedOn="{StaticResource GeoButton}"/>

    <Style x:Key="FormButton"
           TargetType="Button"
           BasedOn="{StaticResource GeoButton}"/>

    <Style x:Key="ActionButton"
           TargetType="Button"
           BasedOn="{StaticResource GeoButton}"/>

    <!-- Secondary buttons -->
    <Style x:Key="Secondary"
           TargetType="Button"
           BasedOn="{StaticResource GeoButton}">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    </Style>

    <!-- Sidebar buttons -->
    <Style x:Key="Nav"
           TargetType="Button"
           BasedOn="{StaticResource GeoButton}">

        <Setter Property="Background" Value="#FFF8EE"/>
        <Setter Property="Foreground" Value="#253044"/>
        <Setter Property="BorderBrush" Value="#252B3A"/>
        <Setter Property="Margin" Value="0,0,0,12"/>

        <Style.Triggers>
            <Trigger Property="Tag" Value="active">
                <Setter Property="Background" Value="#F97316"/>
                <Setter Property="Foreground" Value="#253044"/>
                <Setter Property="BorderBrush" Value="#252B3A"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Text inputs -->
    <Style TargetType="TextBox">
        <Setter Property="FontFamily"
                Value="{StaticResource PlayfulGeometricReading}"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Background" Value="#FFFCF6"/>
        <Setter Property="BorderBrush" Value="#9298A4"/>
        <Setter Property="BorderThickness" Value="2"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Field"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="11">

                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin"
                                 Value="True">
                            <Setter TargetName="Field"
                                    Property="BorderBrush"
                                    Value="#C2410C"/>
                        </Trigger>

                        <Trigger Property="Validation.HasError"
                                 Value="True">
                            <Setter TargetName="Field"
                                    Property="BorderBrush"
                                    Value="#B91C1C"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Password inputs -->
    <Style TargetType="PasswordBox">
        <Setter Property="FontFamily"
                Value="{StaticResource PlayfulGeometricReading}"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="FontSize" Value="14"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Field"
                            Background="#FFFCF6"
                            BorderBrush="#9298A4"
                            BorderThickness="2"
                            CornerRadius="11">

                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin"
                                 Value="True">
                            <Setter TargetName="Field"
                                    Property="BorderBrush"
                                    Value="#C2410C"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox -->
    <Style TargetType="ComboBox">
        <Setter Property="FontFamily"
                Value="{StaticResource PlayfulGeometricReading}"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="FocusVisualStyle"
                Value="{StaticResource FocusRing}"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton
                            Style="{x:Null}"
                            Focusable="False"
                            IsChecked="{Binding IsDropDownOpen,
                                RelativeSource={RelativeSource TemplatedParent},
                                Mode=TwoWay}">

                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="#FFFCF6"
                                            BorderBrush="#9298A4"
                                            BorderThickness="2"
                                            CornerRadius="11">

                                        <TextBlock Text="⌄"
                                                   Foreground="#C2410C"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,4"
                                                   FontSize="18"/>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter
                            IsHitTestVisible="False"
                            Margin="12,8,32,8"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding SelectionBoxItem}"
                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                            ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>

                        <Popup x:Name="PART_Popup"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               Focusable="False">

                            <Border
                                Background="White"
                                BorderBrush="#252B3A"
                                BorderThickness="2"
                                CornerRadius="11"
                                Padding="4"
                                MinWidth="{Binding ActualWidth,
                                    RelativeSource={RelativeSource TemplatedParent}}"
                                MaxHeight="{TemplateBinding MaxDropDownHeight}">

                                <ScrollViewer CanContentScroll="True">
                                    <ItemsPresenter
                                        KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    </Style>

    <!-- DataGrid -->
    <Style TargetType="DataGrid">
        <Setter Property="FontFamily"
                Value="{StaticResource PlayfulGeometricReading}"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource Outline}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="GridLinesVisibility" Value="None"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowHeight" Value="48"/>
        <Setter Property="ColumnHeaderHeight" Value="46"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="AlternatingRowBackground" Value="#FFFBF4"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="SelectionMode" Value="Single"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#FFDDB8"/>
        <Setter Property="Foreground" Value="#71320D"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="BorderBrush" Value="#252B3A"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border
                        Background="{TemplateBinding Background}"
                        Padding="{TemplateBinding Padding}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">

                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#FFDDB8"/>
                <Setter Property="Foreground" Value="#253044"/>
            </Trigger>

            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="#C2410C"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Calendar icon beside student date inputs -->
    <Style x:Key="CalendarButton" TargetType="DatePicker">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
        <Setter Property="Language" Value="vi-VN"/>
        <Setter Property="SelectedDateFormat" Value="Short"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="ToolTip" Value="Chọn ngày từ lịch"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Grid>
                        <p:DatePickerTextBox
                            x:Name="PART_TextBox"
                            Visibility="Collapsed"/>

                        <Button x:Name="PART_Button"
                                Style="{x:Null}"
                                Width="36"
                                Height="40"
                                MinWidth="0"
                                MinHeight="0"
                                Padding="0"
                                Focusable="False"
                                Cursor="Hand"
                                AutomationProperties.Name="Chọn ngày"
                                ToolTip="Chọn ngày từ lịch">

                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="CalendarBorder"
                                            Background="#FFE8CF"
                                            BorderBrush="#252B3A"
                                            BorderThickness="2"
                                            CornerRadius="8">

                                        <Grid Width="18" Height="18">
                                            <Path
                                                Data="M3,5 L15,5 L15,16 L3,16 Z
                                                      M3,8 L15,8
                                                      M6,2 L6,6
                                                      M12,2 L12,6
                                                      M6,11 L8,11
                                                      M10,11 L12,11
                                                      M6,14 L8,14"
                                                Stroke="#C2410C"
                                                StrokeThickness="1.5"/>
                                        </Grid>
                                    </Border>

                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter
                                                TargetName="CalendarBorder"
                                                Property="Background"
                                                Value="#FFEDD5"/>
                                        </Trigger>

                                        <Trigger Property="IsEnabled"
                                                 Value="False">
                                            <Setter
                                                TargetName="CalendarBorder"
                                                Property="Opacity"
                                                Value="0.45"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Popup
                            x:Name="PART_Popup"
                            Placement="Bottom"
                            PlacementTarget="{Binding ElementName=PART_Button}"
                            StaysOpen="False"
                            AllowsTransparency="True"
                            IsOpen="{Binding IsDropDownOpen,
                                RelativeSource={RelativeSource TemplatedParent},
                                Mode=TwoWay}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Full DatePicker for academic-record forms -->
    <Style TargetType="DatePicker">
        <Setter Property="MinHeight" Value="42"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="38"/>
                        </Grid.ColumnDefinitions>

                        <p:DatePickerTextBox
                            x:Name="PART_TextBox"
                            Style="{StaticResource {x:Type TextBox}}"
                            Padding="8,7"/>

                        <Button Grid.Column="1"
                                x:Name="PART_Button"
                                Style="{x:Null}"
                                MinWidth="0"
                                Padding="0"
                                Focusable="False"
                                Cursor="Hand"
                                AutomationProperties.Name="Chọn ngày"
                                Margin="4,0,0,0">

                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#FFE8CF"
                                            BorderBrush="#252B3A"
                                            BorderThickness="2"
                                            CornerRadius="9">

                                        <TextBlock Text="▦"
                                                   FontSize="22"
                                                   Foreground="#C2410C"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Popup
                            x:Name="PART_Popup"
                            Placement="Bottom"
                            StaysOpen="False"
                            AllowsTransparency="True"
                            IsOpen="{Binding IsDropDownOpen,
                                RelativeSource={RelativeSource TemplatedParent},
                                Mode=TwoWay}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>