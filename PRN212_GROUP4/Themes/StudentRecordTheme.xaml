<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ui:ThemesDictionary Theme="Light" />
        <ui:ControlsDictionary />
    </ResourceDictionary.MergedDictionaries>
    <SolidColorBrush x:Key="RecordInk" Color="#292524" />
    <SolidColorBrush x:Key="RecordMuted" Color="#756E66" />
    <SolidColorBrush x:Key="RecordAccent" Color="#C2410C" />
    <Style x:Key="RecordCard" TargetType="Border">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="#E8E3DD" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="24" />
    </Style>
    <Style x:Key="RecordLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource RecordMuted}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,18,0,8" />
    </Style>
    <Style x:Key="RecordValue" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource RecordInk}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- Explicit templates keep WPF UI theme states from replacing our brand colors. -->
    <Style x:Key="RecordButton" TargetType="ui:Button">
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Padding" Value="18,11" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="#3E3934" />
        <Setter Property="BorderBrush" Value="#DED7CE" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                        <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.72" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="#C2410C" />
                            <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="RecordPrimaryButton" TargetType="ui:Button" BasedOn="{StaticResource RecordButton}">
        <Setter Property="Background" Value="#C2410C" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="#C2410C" />
    </Style>
    <Style x:Key="RecordArchiveButton" TargetType="ui:Button" BasedOn="{StaticResource RecordButton}">
        <Setter Property="Background" Value="#FFF0E5" />
        <Setter Property="Foreground" Value="#9A3412" />
        <Setter Property="BorderBrush" Value="#FED7AA" />
    </Style>
    <Style x:Key="RecordCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="#3E3934" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" Background="White" BorderBrush="#B9B0A6" BorderThickness="1" VerticalAlignment="Center">
                            <Path x:Name="Check" Data="M 3,8 L 6.5,11.5 L 13,4.5" Stroke="White" StrokeThickness="2" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="#C2410C" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="#C2410C" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="#C2410C" />
                            <Setter TargetName="Box" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="RecordInput" TargetType="ui:TextBox" BasedOn="{StaticResource {x:Type ui:TextBox}}">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style x:Key="RecordStatus" TargetType="Border">
        <Setter Property="Background" Value="#FFF7ED" />
        <Setter Property="BorderBrush" Value="#FFE8D6" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding StatusMessage}" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="RecordBadge" TargetType="Border">
        <Setter Property="Background" Value="#E7F5EF" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsArchived}" Value="True">
                <Setter Property="Background" Value="#F0EDE8" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="RecordBadgeText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#15704A" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsArchived}" Value="True">
                <Setter Property="Foreground" Value="#655E57" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="RecordBusyBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="3" />
        <Setter Property="IsIndeterminate" Value="True" />
        <Setter Property="Foreground" Value="{StaticResource RecordAccent}" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
